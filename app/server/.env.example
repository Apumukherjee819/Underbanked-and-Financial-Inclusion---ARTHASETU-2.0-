# ArthaSetu Security API - Environment Variables
# Copy to .env and configure

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arthasetu
DB_USER=postgres
DB_PASS=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=arthasetu-pqc-secret-change-in-production

# CORS
CORS_ORIGIN=*
